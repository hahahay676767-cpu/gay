local FARMLAND_MAX_X = -1  -- Farmland priority: X <= -1

local function IsReservedVoxel(voxel)
    local Restaurants = GetRestaurantsModule()
    if not Restaurants then return false end
    return voxel == Restaurants.EmployeeSpawnVoxel or voxel == Restaurants.DoorwayVoxel
end

-- Get bare ground voxels (walkable, empty Middle & Floor levels)
local function GetBareGroundVoxels(restaurant, floor, onlyFarmland)
    local ok, walkable = pcall(function()
        return restaurant:GetWalkableVoxels()
    end)
    if not ok or not walkable then
        return {}
    end

    local Types = GetEntityTypesModule()
    if not Types then return {} end

    local plantable = {}
    for _, voxel in ipairs(walkable) do
        if not IsReservedVoxel(voxel) and (not onlyFarmland or voxel.X <= FARMLAND_MAX_X) then
            local okMid, midEntity = pcall(function()
                return restaurant:GetEntityByVoxel(voxel, Types.HeightLevel.Middle, floor)
            end)
            local okFloor, floorEntity = pcall(function()
                return restaurant:GetEntityByVoxel(voxel, Types.HeightLevel.Floor, floor)
            end)

            local middleEmpty = okMid and midEntity == nil
            local floorEmpty = okFloor and floorEntity == nil

            if middleEmpty and floorEmpty then
                table.insert(plantable, voxel)
            end
        end
    end

    return plantable
end

-- Prioritized: Farmland first (X <= -1), then other bare ground
local function GetPlantableVoxelsPrioritized(restaurant, floor)
    local farmlandVoxels = GetBareGroundVoxels(restaurant, floor, true)

    local farmlandLookup = {}
    for _, v in ipairs(farmlandVoxels) do
        farmlandLookup[v.X .. "_" .. v.Y] = true
    end

    local allBareGround = GetBareGroundVoxels(restaurant, floor, false)
    local otherVoxels = {}
    for _, v in ipairs(allBareGround) do
        local key = v.X .. "_" .. v.Y
        if not farmlandLookup[key] then
            table.insert(otherVoxels, v)
        end
    end

    local result = {}
    for _, v in ipairs(farmlandVoxels) do
        table.insert(result, v)
    end
    for _, v in ipairs(otherVoxels) do
        table.insert(result, v)
    end

    return result, #farmlandVoxels, #otherVoxels
end

local function WaitForWheatPlantConfirmed(restaurant, voxel, floor, timeout)
    local Types = GetEntityTypesModule()
    if not Types then return false end
    
    local deadline = tick() + (timeout or 1.5)
    while tick() < deadline do
        local ok, entity = pcall(function()
            return restaurant:GetEntityByVoxel(voxel, Types.HeightLevel.Middle, floor)
        end)
        if ok and entity then
            return true
        end
        task.wait(0.1)
    end
    return false
end

