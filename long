-- ============================================================
-- SelectFocusQuest - SATU-SATUNYA tempat logic prioritas quest.
-- Dipakai bareng oleh AutoCompleteQuests() (yang benerin actionnya) dan
-- monitor loop di bawah (yang cuma update GUI). Kalau dua tempat itu
-- makai fungsi seleksi yang beda, hasilnya bisa beda quest -> GUI flicker.
-- v3.9: Harvest (7) removed - handled separately as PRIORITY #1
-- Priority: Serve (1/8) > Cook (10) > Earn (3) > Purchase (2) > Place (12)
--           > Hire (4) > Dish (5)
-- ============================================================
-- Goal.Type reference (from GoalTypes):
-- Type 1 = Customer (Serve) - MILESTONE
-- Type 2 = Purchase | Type 3 = Earn | Type 4 = Hire | Type 5 = Dish
-- Type 7 = Harvest - MILESTONE (Farming)
-- Type 8 = ServeRecipe - MAIN QUEST | Type 10 = Cook | Type 12 = Place
local QuestPriorityOrder = {8, 10, 3, 2, 12, 4, 5}  -- Skip Type 1, 7 (milestones)

local function SelectFocusQuest(activeGoals)
    if not activeGoals or not next(activeGoals) then
        return nil
    end

    -- Phase 1: completed quest diklaim duluan, apapun tipenya (except milestones)
    for _, goalData in pairs(activeGoals) do
        -- Exclude: Type 1 (Customer milestone), Type 7 (Harvest milestone), and ANY quest with Tag1="Milestone"
        if goalData.Completed and goalData.Type ~= 1 and goalData.Type ~= 7 and goalData.Tag1 ~= "Milestone" then
            return goalData
        end
    end

    -- Phase 2: pilih SATU uncompleted MAIN QUEST berdasarkan priority order
    for _, priorityType in ipairs(QuestPriorityOrder) do
        for _, goalData in pairs(activeGoals) do
            -- Exclude milestone quests (Type 1, 7, or Tag1="Milestone")
            if not goalData.Completed and goalData.Type == priorityType and goalData.Tag1 ~= "Milestone" then
                return goalData
            end
        end
    end

    -- Fallback: tipe quest yang gak ada di priority order (tapi skip milestone!)
    for _, goalData in pairs(activeGoals) do
        -- Exclude: Type 1, Type 7, and Tag1="Milestone"
        if not goalData.Completed and goalData.Type ~= 1 and goalData.Type ~= 7 and goalData.Tag1 ~= "Milestone" then
            return goalData
        end
    end

    return nil
end

