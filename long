    if not InitializeModules() then
        Running = false
        State.farming = false
        if GUI_Loaded and GUI and GUI.FarmBtn then
            GUI.FarmBtn.Text = "START AUTO FARM"
            GUI.FarmBtn.BackgroundColor3 = Color3.fromRGB(234, 179, 8)
        end
        UpdateStatus("Initialization Failed", nil)
        return
    end

    -- Mark modules as ready for placement watchers
    MarkModulesReady()

    -- ============================================================
    -- STARTUP CHECK: Land Plot 1 already purchased? → Skip to Step 3!
    -- ============================================================
    local landPlot1Purchased = IsLandPlot1Purchased()
    
    if landPlot1Purchased then
        -- Land Plot 1 already purchased → Start farming immediately!
        LayoutPrepTriggered = true
        LayoutPrepPhaseActive = true
        AutoHarvestCropEnabled = true
        CurrentStep = 3  -- Jump to farming phase
        
        print("[KAITUN DEBUG] STARTUP: Land Plot 1 detected! Starting farming mode...")
        
        -- START HARVEST LOOP (deferred until after script loads)
        task.defer(function()
            task.wait(0.5)
            if StartHarvestLoop then
                StartHarvestLoop()
            end
            
            -- START AUTO-SELL!
            task.wait(0.2)
            if StartAutoSell then
                StartAutoSell()
            end
            
            -- START AUTO-CLAIM MILESTONES!
            task.wait(0.2)
            if StartAutoClaimMilestones then
                StartAutoClaimMilestones()
            end
        end)
        
        UpdateStatus("Step 3: Farming | Auto Harvesting...", nil)
        
        -- Enable automation modules
        AutoPlaceFurnitureEnabled = true
        RunFurnitureWatcher()
        -- Auto Buy Plots runs independently (no flag needed)
        AutoClaimEarningsEnabled = true
        AutoEnableRecipeEnabled = true
        RunRecipeWatcher()
        
        task.spawn(MainLoop)
        return
    end

    -- GAK ADA WHEAT → NORMAL FLOW (QUEST AUTOMATION)
    
    -- ============================================================
    -- v4.2: IMMEDIATE CHECK - Farming skill already unlocked?
    -- DEBUG: Check farming status untuk troubleshooting
    -- ============================================================
    local farmingUnlocked = IsFarmingSkillUnlocked()
    local farmingLevel = GetFarmingSkillLevel()
    
    print(string.format("[KAITUN DEBUG] Farming Status Check:"))
    print(string.format("  - IsFarmingSkillUnlocked(): %s", tostring(farmingUnlocked)))
    print(string.format("  - GetFarmingSkillLevel(): %d", farmingLevel))
    
    -- Trigger Step 2 if farming unlocked (NOT just level >= 1, need actual unlock!)
    if farmingUnlocked then
        LayoutPrepPhaseActive = true
        CurrentStep = 2  -- Jump to Step 2
        
        print("[KAITUN DEBUG] TRIGGERED STEP 2 - Farming detected!")
        
        -- Enable wheat/fridge watchers already active (default true)
        -- They will start buying/placing immediately
        
        UpdateStatus("Step 2: Auto Buy & Place Wheat/Fridge | Farming Unlocked", nil)
    else
        print("[KAITUN DEBUG] STEP 1 - Farming not unlocked yet")
        UpdateStatus("Step 1: Quest Automation | Working to unlock Farming", nil)
    end

    print("[KAITUN DEBUG] StartKaitun: Enabling automation modules...")
    
    -- Enable all automation modules
    AutoPlaceFurnitureEnabled = true
    RunFurnitureWatcher()

    -- v3.9: Auto Claim Cash Register/Tip Jar/Ice Cream Cart - ALWAYS ON
    AutoClaimEarningsEnabled = true
    
    -- Spawn Claim Earnings loop (with TP + detection via ClientCashRegister.Eligible)
    task.spawn(function()
        local myToken = State.LoopToken  -- Capture current token
        
        while myToken == State.LoopToken do
            task.wait(2) -- Check every 2s
            
            if not AutoClaimEarningsEnabled or not Running then
                continue
            end

            local claimed = false
            pcall(function()
                UpdateTask("Claim Cash")
                claimed = ClaimAllCashRegisters()
            end)
            
            if not claimed then
                ResetTaskPriority() -- Reset to Idle when nothing to claim
            end
        end
        
        print("[KAITUN DEBUG] Claim earnings loop #2 exited (token:", myToken, "current:", State.LoopToken, ")")
    end)

    if #Config.ShopBuyItems > 0 or #Config.ShopBuyCategories > 0 then
        AutoBuyShopEnabled = true
    end

    AutoEnableRecipeEnabled = true
    RunRecipeWatcher()

    -- v4.1: Auto Remove Decor enabled (continuous watcher runs automatically)
    AutoRemoveDecorEnabled = true
    
    -- v4.1: Auto Remove Furniture enabled (conditional trigger after Quest #28)
    AutoRemoveFurnitureEnabled = true

    -- v4.1: Auto Place Rusty Sink enabled (continuous watcher runs automatically)
    -- No need to call RunRustySinkPlacementWatcher() - watcher loop is built-in

    -- v3.9: START HARVEST LOOP - Priority #1, runs at ANY step!
    task.defer(function()
        task.wait(0.5)
        if StartHarvestLoop then
            StartHarvestLoop()
        else
        end
    end)
    
    -- v3.9: START DISHWASHER LOOP - Priority #2, runs at ANY step!
    task.defer(function()
        task.wait(0.6)
        if StartDishwasherLoop then
            StartDishwasherLoop()
        else
        end
    end)

    -- Do NOT overwrite status - each branch sets its own status
    print("[KAITUN DEBUG] StartKaitun: About to spawn MainLoop...")
    task.spawn(MainLoop)
    print("[KAITUN DEBUG] StartKaitun: MainLoop spawned! Script running.")
end

local function StopKaitun()
    if not Running then
        return
    end
    
    -- INCREMENT TOKEN - Cancels ALL loops instantly! (No task.wait needed)
    State.LoopToken = State.LoopToken + 1
    print("[KAITUN DEBUG] StopKaitun: Token incremented to", State.LoopToken)
    
    Running = false
    State.farming = false

    -- Disable all automation
    AutoSitEnabled = false
    AutoTakeOrderEnabled = false
    AutoCookingEnabled = false
    AutoServeEnabled = false
    AutoDishwasherEnabled = false
    AutoClaimEarningsEnabled = false
    AutoPlaceFurnitureEnabled = false
    AutoBuyWheatEnabled = false
    AutoBuyFridgeEnabled = false
    AutoBuyShopEnabled = false
    AutoBuyRustySinkEnabled = false
    AutoHarvestCropEnabled = false
    AutoEnableRecipeEnabled = false
    AutoPlaceRustySinkEnabled = false
    AutoRemoveDecorEnabled = false
    AutoRemoveFurnitureEnabled = false
    
    -- Reset Step-related flags (IMPORTANT for restart!)
    LayoutPrepPhaseActive = false
    LayoutPrepTriggered = false
    
    -- Reset loop running flags (loops exit via token check)
    HarvestLoopRunning = false
    DishwasherLoopRunning = false
    getgenv().KaitunAutoSellRunning = false
    FurnitureWatcherRunning = false
    WheatBuyWatcherRunning = false
    FridgeBuyWatcherRunning = false
    RecipeWatcherRunning = false

    UpdateStatus("Stopped", nil)
    UpdateTask("Idle")
end

