local function GetTotalFurnitureCount()
    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end
    
    -- Count placed furniture (all floors) via voxel-scan
    local PlacedTables = CachedRestaurant and GetPlacedFurnitureCount(CachedRestaurant, FurnitureConfig.TableItem, nil) or 0
    local PlacedChairs = CachedRestaurant and GetPlacedFurnitureCount(CachedRestaurant, FurnitureConfig.ChairItem, nil) or 0
    
    -- Count inventory
    local TableStock = GetItemStock(FurnitureConfig.TableItem)
    local ChairStock = GetItemStock(FurnitureConfig.ChairItem)
    
    -- Total owned
    local TotalTables = PlacedTables + TableStock
    local TotalChairs = PlacedChairs + ChairStock
    
    return TotalTables, TotalChairs, PlacedTables, PlacedChairs, TableStock, ChairStock
end

local function SmartBuyFurniture()
    local TotalTables, TotalChairs = GetTotalFurnitureCount()
    
    local TargetTables = FurnitureConfig.TargetSets
    local TargetChairs = FurnitureConfig.TargetSets * 2
    
    local TablesNeeded = math.max(0, TargetTables - TotalTables)
    local ChairsNeeded = math.max(0, TargetChairs - TotalChairs)
    
    if TablesNeeded <= 0 and ChairsNeeded <= 0 then
        return
    end
    
    local TableGap = TargetTables - TotalTables
    local ChairGap = (TargetChairs - TotalChairs) / 2
    
    if TableGap > 0 and ChairGap > 0 then
        if TableGap >= ChairGap then
            PurchaseItemFromShop(FurnitureConfig.TableItem, 1)
        else
            PurchaseItemFromShop(FurnitureConfig.ChairItem, 1)
        end
    elseif TableGap > 0 then
        PurchaseItemFromShop(FurnitureConfig.TableItem, 1)
    elseif ChairGap > 0 then
        PurchaseItemFromShop(FurnitureConfig.ChairItem, 1)
    end
end

local AutoPlaceFurnitureEnabled = false
local AutoPlaceFurnitureRunning = false

local function TryAutoPlaceFurniture()
    if not AutoPlaceFurnitureEnabled or AutoPlaceFurnitureRunning then
        return
    end
    
    -- Try acquire global placement lock
    if not AcquirePlacementLock("Furniture") then
        return  -- Another placement system is running
    end

    -- Only stop furniture placement at Step 3 (Land Plot 1 purchased)
    -- Step 1 & 2 still need chairs/tables for quest automation!
    if CurrentStep >= 3 then
        ReleasePlacementLock("Furniture")
        return
    end

    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end
    if not CachedRestaurant then
        ReleasePlacementLock("Furniture")
        return
    end

    local Floor = GetPlayerFloor(CachedRestaurant)
    
    -- Analyze per-table completeness first
    local CompleteCount, Incomplete = AnalyzeTableCompleteness(CachedRestaurant, Floor, FurnitureConfig.TableItem, FurnitureConfig.ChairItem)
    
    -- Initialize skip list if not exists
    if not getgenv().FurnitureRepairSkip then
        getgenv().FurnitureRepairSkip = {}
    end
    if not getgenv().FurnitureRepairAttempts then
        getgenv().FurnitureRepairAttempts = {}
    end
    
    -- Filter incomplete tables that can be repaired (has missingVoxel & slot is empty & not in skip list)
    local RepairTargets = {}
    for _, item in ipairs(Incomplete) do
        if item.missingVoxel and not IsVoxelOccupied(CachedRestaurant, item.missingVoxel, Floor, GetEntityTypesModule()) then
            local skipKey = item.tableVoxel.X .. "_" .. item.tableVoxel.Y
            if not getgenv().FurnitureRepairSkip[skipKey] then
                table.insert(RepairTargets, item)
            end
        end
    end
    
    local ChairStockForRepair = GetItemStock(FurnitureConfig.ChairItem)
    
    if #RepairTargets > 0 and ChairStockForRepair > 0 then
        -- Repair incomplete tables FIRST before building new sets
        AutoPlaceFurnitureRunning = true
        
        task.spawn(function()
            local repaired = RepairIncompleteTables(CachedRestaurant, Floor, RepairTargets, FurnitureConfig.ChairItem, ChairStockForRepair)
            
            -- Track repair failures
            if repaired == 0 and #RepairTargets > 0 then
                local attemptKey = RepairTargets[1].tableVoxel.X .. "_" .. RepairTargets[1].tableVoxel.Y
                getgenv().FurnitureRepairAttempts[attemptKey] = (getgenv().FurnitureRepairAttempts[attemptKey] or 0) + 1
                
                -- Permanently skip after 3 failed attempts
                if getgenv().FurnitureRepairAttempts[attemptKey] >= 3 then
                    getgenv().FurnitureRepairSkip[attemptKey] = true
                    getgenv().FurnitureRepairAttempts[attemptKey] = nil
                end
            elseif repaired > 0 then
                -- Reset attempts on success
                getgenv().FurnitureRepairAttempts = {}
            end
            
            AutoPlaceFurnitureRunning = false
            ReleasePlacementLock("Furniture")  -- Release lock after repair
            TryAutoPlaceFurniture() -- Re-check after repair
        end)
        return
    end
    
    -- No more repairs needed, check if need to build new sets
    local NeededSets = math.max(0, FurnitureConfig.TargetSets - CompleteCount)

    if NeededSets <= 0 then
        ReleasePlacementLock("Furniture")
        return -- Target already met
    end

    local TotalTables, TotalChairs, PlacedTables, PlacedChairs, TableStock, ChairStock = GetTotalFurnitureCount()
    
    local TargetTables = FurnitureConfig.TargetSets
    local TargetChairs = FurnitureConfig.TargetSets * 2
    
    if TotalTables >= TargetTables and TotalChairs >= TargetChairs then
        -- Total target met, but may still need to place from inventory
        if TableStock > 0 and ChairStock >= 2 and NeededSets > 0 then
            -- Continue to placement below
        else
            ReleasePlacementLock("Furniture")
            return
        end
    end

    local MaxSetsByStock = math.min(NeededSets, TableStock, math.floor(ChairStock / 2))

    if MaxSetsByStock <= 0 then
        ReleasePlacementLock("Furniture")
        SmartBuyFurniture()
        return
    end

    AutoPlaceFurnitureRunning = true

    task.spawn(function()
        local Voxels = GetNonDockPlaceableVoxels(CachedRestaurant, Floor)

        if #Voxels == 0 then
            AutoPlaceFurnitureRunning = false
            ReleasePlacementLock("Furniture")
            return
        end

        local PlacedNow = PlaceFurnitureSets(
            CachedRestaurant,
            Voxels,
            FurnitureConfig.TableItem,
            FurnitureConfig.ChairItem,
            MaxSetsByStock,
            TableStock,
            ChairStock,
            Floor
        )

        AutoPlaceFurnitureRunning = false
        ReleasePlacementLock("Furniture")  -- Release lock after placement
        TryAutoPlaceFurniture() -- Re-check after placement
    end)
end

