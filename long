-- Module cache table - CONSOLIDATED (reduce local function count)
-- ============================================================
local ModuleCache = {}

local function GetCachedModule(moduleName)
    if ModuleCache[moduleName] then
        return ModuleCache[moduleName]
    end
    
    local paths = {
        Saving = "Framework.Client.Saving",
        GoalCmds = "Framework.Client.GoalCmds",
        QuestCmds = "Framework.Client.QuestCmds",
        QuestDirectory = "Framework.Directory.Quest",
        ItemDirectory = "Framework.Directory.Item",
        LayoutsCmds = "Framework.Client.LayoutsCmds",
        LayoutsType = "Framework.Types.Layouts",
        ItemUtil = "Framework.Universal.ItemUtil",
        InventoryCmds = "Framework.Client.InventoryCmds",
        Shop = "Framework.Universal.Shop",
        ShopCmds = "Framework.Client.ShopCmds",
        Recipe = "Framework.Directory.Recipe",
        RecipeCmds = "Framework.Client.RecipeCmds",
        EntityPackage = "Framework.Directory.EntityPackage",
        EntityPackageTypes = "Framework.Directory.EntityPackage.Types",
        SkillsCmds = "Framework.Client.SkillsCmds",
        SkillDirectory = "Framework.Directory.Skill",
        Restaurants = "Framework.Types.Restaurants",
        EntityTypes = "Framework.Directory.Entity.Types",
        ApplianceTypes = "Framework.Directory.Entity.ApplianceTypes",
        CurrencyCmds = "Framework.Client.CurrencyCmds",
        ProgressionUtil = "Framework.Universal.ProgressionUtil",
        EntityUtil = "Framework.Universal.EntityUtil",
        ClientDishwasher = "Framework.Client.ClientEntity.ClientDishwasher",
        ClientCashRegister = "Framework.Client.ClientEntity.ClientCashRegister",
    }
    
    local path = paths[moduleName]
    if not path then
        return nil
    end
    
    local ok, module = pcall(function()
        local parts = {}
        for part in path:gmatch("[^.]+") do
            table.insert(parts, part)
        end
        
        local current = ReplicatedStorage
        for _, part in ipairs(parts) do
            current = current:FindFirstChild(part)
            if not current then
                return nil
            end
        end
        
        return require(current)
    end)
    
    if ok and module then
        ModuleCache[moduleName] = module
    end
    
    return ok and module or nil
end

