local function ParseHireGoal(goalData)
    local EntityUtil = GetEntityUtil()
    if not EntityUtil or not EntityUtil.Employees then
        return nil, nil
    end

    local goal = goalData.GoalData and goalData.GoalData.Goal
    if not goal then
        return nil, nil
    end

    -- Case 1: StaffId spesifik -> langsung valid sebagai key Employees
    if goal.StaffId and EntityUtil.Employees[goal.StaffId] then
        return goal.StaffId, nil
    end

    -- Case 2: StaffClass generik -> nanti dipilih 1 employee dari kelas
    -- itu yang belum dimiliki, sudah unlocked, dan cash cukup
    if goal.StaffClass then
        return nil, goal.StaffClass
    end

    return nil, nil
end

-- Cari 1 employee manapun dari subclass tertentu yang belum dimiliki,
-- sudah unlocked, dan cash cukup -- dipakai kalau Goal cuma punya
-- StaffClass (generik) tanpa StaffId spesifik.
local function FindHireableFromClass(staffClass)
    local EntityUtil = GetEntityUtil()
    local ProgressionUtil = GetProgressionUtil()
    local CurrencyCmds = GetCurrencyCmds()

    if not EntityUtil or not EntityUtil.Employees or not ProgressionUtil or not CurrencyCmds then
        return nil, nil
    end

    local cash = 0
    pcall(function() cash = CurrencyCmds.Get("Cash") or 0 end)

    for employeeId, employeeDir in pairs(EntityUtil.Employees) do
        if employeeDir.Subclass == staffClass and not IsEmployeeOwned(employeeDir) then
            local unlockedOk, unlocked = pcall(function()
                return ProgressionUtil.IsEmployeeUnlocked(LocalPlayer, employeeId)
            end)
            if unlockedOk and unlocked then
                local price = employeeDir.Price or math.huge
                if cash >= price then
                    return employeeId, employeeDir
                end
            end
        end
    end

    return nil, nil
end

local function HireEmployeeFromQuest(goalData)
    local EntityUtil = GetEntityUtil()
    if not EntityUtil or not EntityUtil.Employees then
        return false
    end

    local employeeId, staffClass = ParseHireGoal(goalData)

    if employeeId then
        local employeeDir = EntityUtil.Employees[employeeId]
        if not employeeDir then
            return false
        end
        return PurchaseEmployee(employeeId, employeeDir)
    end

    if staffClass then
        local candidateId, candidateDir = FindHireableFromClass(staffClass)
        if not candidateId then
            return false
        end
        return PurchaseEmployee(candidateId, candidateDir)
    end

    return false
end

