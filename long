-- Task Priority System (higher number = higher priority)
local TaskPriority = {
    ["Idle"] = 0,
    ["Sit Customer"] = 1,
    ["Take Order"] = 2,
    ["Dishwasher"] = 3,
    ["Claim Cash"] = 4,
    ["Harvest"] = 5,
    ["Cooking"] = 6,
    ["Serve"] = 7,
}

local TASK_UPDATE_COOLDOWN = 0.5 -- Update max 1x per 0.5s

-- Update Task display (realtime activity with priority & debounce)
local function UpdateTask(taskName)
    taskName = taskName or "Idle"
    
    local newPriority = TaskPriority[taskName] or 0
    local now = tick()
    
    -- Only update if:
    -- 1. New task has HIGHER priority than current, OR
    -- 2. Cooldown expired (0.5s passed since last update)
    if newPriority > CurrentTaskPriority or (now - LastTaskUpdate) >= TASK_UPDATE_COOLDOWN then
        State.task = taskName
        CurrentTaskPriority = newPriority
        LastTaskUpdate = now
        
        -- Update GUI immediately (no caching)
        if GUI_Loaded and GUI and GUI.updateTaskLabel then
            pcall(function()
                GUI.updateTaskLabel()
            end)
        end
    end
end

-- Reset task priority to Idle (called when automation stops or waiting)
local function ResetTaskPriority()
    CurrentTaskPriority = 0
    UpdateTask("Idle")
end

-- ============================================================
-- AUTO SKIP TUTORIAL (v3.9)
-- Polls Saving data until it's loaded (no timeout - works even if
-- Saving/tutorial takes minutes to appear).
-- Only invokes the skip remote when tutorial is confirmed NOT complete.
-- Stops permanently once skipped (or already complete) - never spams
-- the remote afterward.
-- ============================================================
local function AutoSkipTutorial()
    
    local Network = nil
    local Saving = nil
    local POLL_INTERVAL = 2
    local done = false
    
    -- Load required modules
    pcall(function()
        Network = require(ReplicatedStorage.Framework.Client.Network)
        Saving = require(ReplicatedStorage.Framework.Client.Saving)
    end)
    
    if not Network or not Saving then
        return
    end
    
    local function isTutorialComplete()
        local data = Saving.Get()
        if not data then
            return nil -- data not loaded yet, unknown state
        end
        return data.TutorialComplete == true
    end
    
    -- Stop immediately if game itself signals tutorial completion
    pcall(function()
        Network.Fired("Tutorial_Complete_Success"):Connect(function()
            done = true
        end)
    end)
    
    task.spawn(function()
        while not done do
            local complete = isTutorialComplete()
            
            if complete == true then
                -- Already done (or no tutorial for this player) - stop, no remote call
                done = true
                break
            elseif complete == false then
                -- Confirmed incomplete - safe to invoke skip
                local success, result = pcall(function()
                    return Network.Invoke("Tutorial_Complete")
                end)
                
                if success and result then
                    done = true
                    break
                end
                -- If invoke failed/returned false, loop again after interval
                -- (won't spam since it only re-checks every POLL_INTERVAL sec)
            end
            
            -- complete == nil means Saving data not loaded yet -> just wait, no invoke
            task.wait(POLL_INTERVAL)
        end
    end)
end

