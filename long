-- Based on dishwasher-akurat reference - accurate capacity check
-- ============================================================
local DishwasherLoopRunning = false
local CachedClientDishwasher = nil

-- Helper: Check if dishwasher is full
local function IsDishwasherFull(dishwasher)
    if not CachedClientDishwasher then
        return true -- Assume full if module not loaded
    end
    
    local ok, capacity = pcall(function()
        return CachedClientDishwasher.ComputeCapacity(dishwasher)
    end)
    if not ok or not capacity then
        return true -- Failed to read capacity, skip to be safe
    end
    
    local reserved = dishwasher:GetSession("ReservedCount") or 0
    local completionTs = dishwasher:GetSession("CompletionTimestamp")
    local activeCount = 0
    
    if completionTs and workspace:GetServerTimeNow() < completionTs then
        activeCount = 1
    end
    
    return (reserved + activeCount) >= capacity
end

-- Find available dishwasher (not full)
local function GetAvailableDishwasher()
    local restaurant = CachedRestaurant or (CachedClientRestaurant and CachedClientRestaurant.GetLocal())
    if not restaurant then
        return nil
    end
    
    -- Sticky target: keep using same dishwasher if not full
    local dishwasherId = LocalPlayer:GetAttribute("TargetDishwasherId")
    if dishwasherId then
        local entity = restaurant:GetEntity(dishwasherId)
        if entity and not IsDishwasherFull(entity) then
            return entity
        end
    end
    
    -- Priority: local player's dishwasher that's not full
    for _, dishwasher in ipairs(restaurant:CollectSubclass("Dishwasher")) do
        local isLocalOk, isLocal = pcall(function()
            return dishwasher:IsLocal()
        end)
        if isLocalOk and isLocal and not IsDishwasherFull(dishwasher) then
            return dishwasher
        end
    end
    
    -- Fallback: any dishwasher that's not full
    for _, dishwasher in ipairs(restaurant:CollectSubclass("Dishwasher")) do
        if not IsDishwasherFull(dishwasher) then
            return dishwasher
        end
    end
    
    return nil -- All full or no dishwasher
end

-- Find dirty seat
local function GetDirtySeat()
    local restaurant = CachedRestaurant or (CachedClientRestaurant and CachedClientRestaurant.GetLocal())
    if not restaurant then
        return nil
    end
    
    for _, seat in ipairs(restaurant:CollectSubclass("Seat")) do
        if seat:GetSession("DirtyDish") then
            return seat
        end
    end
    
    return nil
end

