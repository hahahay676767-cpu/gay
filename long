local CachedMilestoneCmds = nil

local function GetFarmingMilestoneProgress()
    -- Get total crops harvested from Farming milestone goals
    local saveData = CachedSaving and CachedSaving.Get()
    if not saveData or not saveData.Goals then return 0 end
    
    -- Farming milestones track "Harvest X crops" goal (Type 7)
    -- Find all farming milestone goals and sum progress
    local totalCrops = 0
    for goalId, goalData in pairs(saveData.Goals) do
        if goalData.Goal and goalData.Goal.Type == 7 then  -- Type 7 = Harvest crops
            -- Check if it's a farming milestone (Tag1 or Tag2 contains "Farming")
            local isFarming = false
            if goalData.Tag1 and tostring(goalData.Tag1):find("Farming") then
                isFarming = true
            end
            if goalData.Tag2 and tostring(goalData.Tag2):find("Farming") then
                isFarming = true
            end
            
            if isFarming and goalData.Progress then
                totalCrops = totalCrops + goalData.Progress
            end
        end
    end
    
    return totalCrops
end

local function GetCurrentFarmingMilestone()
    -- Get current farming milestone name and progress for Active Quest display
    local saveData = CachedSaving and CachedSaving.Get()
    if not saveData or not saveData.Goals then 
        return "Farming Milestone" 
    end
    
    -- Find active (not completed) farming milestone
    for goalId, goalData in pairs(saveData.Goals) do
        if goalData.Goal and goalData.Goal.Type == 7 and not goalData.Completed then
            local isFarming = false
            local milestoneName = "FARMING"
            
            if goalData.Tag1 and tostring(goalData.Tag1):find("Farming") then
                isFarming = true
                -- Extract milestone name (e.g. "FARMING I", "FARMING II", "FARMING III")
                local extracted = tostring(goalData.Tag1):match("Farming (%w+)")
                if extracted then
                    milestoneName = "FARMING " .. extracted
                end
            end
            if goalData.Tag2 and tostring(goalData.Tag2):find("Farming") then
                isFarming = true
                local extracted = tostring(goalData.Tag2):match("Farming (%w+)")
                if extracted then
                    milestoneName = "FARMING " .. extracted
                end
            end
            
            if isFarming and goalData.Progress and goalData.Goal.Amount then
                local progress = goalData.Progress
                local target = goalData.Goal.Amount
                -- Format: "FARMING I | Harvest 500/1,000 Crops!"
                local result = string.format("%s | Harvest %s/%s Crops!", 
                    milestoneName, 
                    tostring(progress):gsub("(%d)(%d%d%d)$", "%1,%2"),  -- Add comma
                    tostring(target):gsub("(%d)(%d%d%d)$", "%1,%2")     -- Add comma
                )
                return result
            end
        end
    end
    
    return "FARMING III | Completed!"
end

