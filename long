local function AnalyzeTableCompleteness(restaurant, floor, tableDisplayName, chairDisplayName)
    local tableVoxels = FindTableVoxels(restaurant, floor, tableDisplayName)
    local Types = GetEntityTypesModule()
    if not Types then
        return 0, {}, 0
    end

    local completeCount = 0
    local incomplete = {}

    for _, tableVoxel in ipairs(tableVoxels) do
        local matchedPair = false

        for _, pair in ipairs(FurnitureOppositeNeighborPairs) do
            local v1 = Vector2.new(tableVoxel.X + pair[1][1], tableVoxel.Y + pair[1][2])
            local v2 = Vector2.new(tableVoxel.X + pair[2][1], tableVoxel.Y + pair[2][2])

            local occ1, isChair1 = CheckChairVoxel(restaurant, v1, floor, chairDisplayName)
            local occ2, isChair2 = CheckChairVoxel(restaurant, v2, floor, chairDisplayName)

            if isChair1 or isChair2 then
                matchedPair = true
                if isChair1 and isChair2 then
                    completeCount = completeCount + 1
                elseif isChair1 and not occ2 then
                    table.insert(incomplete, { tableVoxel = tableVoxel, missingVoxel = v2 })
                elseif isChair2 and not occ1 then
                    table.insert(incomplete, { tableVoxel = tableVoxel, missingVoxel = v1 })
                else
                    table.insert(incomplete, { tableVoxel = tableVoxel, missingVoxel = nil })
                end
                break
            end
        end

        if not matchedPair then
            table.insert(incomplete, { tableVoxel = tableVoxel, missingVoxel = nil })
        end
    end

    return completeCount, incomplete, #tableVoxels
end

local function RepairIncompleteTables(restaurant, floor, repairTargets, chairItem, chairStock)
    local Network = GetNetwork()
    if not Network then
        return 0, chairStock
    end
    
    local repaired = 0

    for _, item in ipairs(repairTargets) do
        if chairStock <= 0 then
            break
        end

        local missingVoxel = item.missingVoxel
        local rotation = ComputeChairRotation(missingVoxel, item.tableVoxel)

        task.wait(FurnitureConfig.BuildDebounce)
        pcall(function()
            Network.Fire("Build_Place", chairItem, missingVoxel.X, missingVoxel.Y, rotation, floor)
        end)

        local confirmed = WaitForPlacementConfirmed(restaurant, missingVoxel, floor, 2)

        if confirmed then
            chairStock = chairStock - 1
            repaired = repaired + 1
        end
    end

    return repaired, chairStock
end

local function PlaceFurnitureSets(restaurant, voxels, tableItem, chairItem, maxSets, tableStock, chairStock, floor)
    local Network = GetNetwork()
    if not Network then
        return 0, {}, {}
    end

    local lookup = BuildFurnitureVoxelLookup(voxels)
    local placedSets = 0
    local skippedAnchors = {}
    local incompleteAnchors = {}

    for _, anchor in ipairs(voxels) do
        if placedSets >= maxSets or tableStock <= 0 or chairStock < 2 then
            break
        end

        local anchorKey = anchor.X .. "_" .. anchor.Y
        if lookup[anchorKey] then

            local neighborKeys = nil
            for _, pair in ipairs(FurnitureOppositeNeighborPairs) do
                local key1 = (anchor.X + pair[1][1]) .. "_" .. (anchor.Y + pair[1][2])
                local key2 = (anchor.X + pair[2][1]) .. "_" .. (anchor.Y + pair[2][2])
                if lookup[key1] and lookup[key2] then
                    neighborKeys = { key1, key2 }
                    break
                end
            end

            if neighborKeys then
                lookup[anchorKey] = nil

                task.wait(FurnitureConfig.BuildDebounce)

                pcall(function()
                    Network.Fire("Build_Place", tableItem, anchor.X, anchor.Y, FurnitureConfig.PlaceRotation, floor)
                end)

                local tableConfirmed = WaitForPlacementConfirmed(restaurant, anchor, floor)

                if not tableConfirmed then
                    table.insert(skippedAnchors, anchor)
                else
                    tableStock = tableStock - 1

                    local chairsConfirmed = 0
                    for i = 1, 2 do
                        local chairVoxel = lookup[neighborKeys[i]]
                        lookup[neighborKeys[i]] = nil
                        local chairRotation = ComputeChairRotation(chairVoxel, anchor)

                        task.wait(FurnitureConfig.BuildDebounce)

                        pcall(function()
                            Network.Fire("Build_Place", chairItem, chairVoxel.X, chairVoxel.Y, chairRotation, floor)
                        end)

                        local chairConfirmed = WaitForPlacementConfirmed(restaurant, chairVoxel, floor, 2)

                        if chairConfirmed then
                            chairsConfirmed = chairsConfirmed + 1
                            chairStock = chairStock - 1
                        end
                    end

                    if chairsConfirmed >= 2 then
                        placedSets = placedSets + 1
                    else
                        table.insert(incompleteAnchors, { anchor = anchor, chairsConfirmed = chairsConfirmed })
                    end
                end
            else
                table.insert(skippedAnchors, anchor)
            end
        end
    end

    return placedSets, skippedAnchors, incompleteAnchors
end

