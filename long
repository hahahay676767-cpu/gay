task.spawn(function()
    -- Auto skip tutorial FIRST
    AutoSkipTutorial()
    
    -- Wait for GUI to load
    local maxWait = 10
    local waited = 0
    
    while not GUI_Loaded and waited < maxWait do
        task.wait(0.5)
        waited = waited + 0.5
    end
    
    -- AUTO-START IMMEDIATELY (v4.2)
    -- Start automation BEFORE GUI connection
    task.wait(1)
    pcall(function()
        StartKaitun()
    end)
    
    if GUI_Loaded and GUI then
        task.wait(0.5)
        
        
        -- Connect Start/Stop button
        if GUI.FarmBtn then
            -- SYNC button with Running state (already true)
            GUI.FarmBtn.Text = "STOP AUTO FARM"
            GUI.FarmBtn.BackgroundColor3 = Color3.fromRGB(225, 29, 72)
            
            -- Disable any existing connections
            for _, connection in pairs(getconnections(GUI.FarmBtn.MouseButton1Click)) do
                connection:Disable()
            end
            
            GUI.FarmBtn.MouseButton1Click:Connect(function()
                -- Wrap in task.spawn to avoid thread capability issues
                task.spawn(function()
                    pcall(function()
                        if Running then
                            -- STOP
                            GUI.FarmBtn.Text = "START AUTO FARM"
                            GUI.FarmBtn.BackgroundColor3 = Color3.fromRGB(234, 179, 8)
                            StopKaitun()
                        else
                            -- START
                            GUI.FarmBtn.Text = "STOP AUTO FARM"
                            GUI.FarmBtn.BackgroundColor3 = Color3.fromRGB(225, 29, 72)
                            StartKaitun()
                        end
                    end)
                end)
            end)
            
        else
            
        end
        
        -- Connect Disable 3D button
        if GUI.Disable3DBtn then
            for _, connection in pairs(getconnections(GUI.Disable3DBtn.MouseButton1Click)) do
                connection:Disable()
            end
            
            GUI.Disable3DBtn.MouseButton1Click:Connect(function()
                task.spawn(function()
                    pcall(function()
                        State.disable3D = not State.disable3D
                        GUI.Disable3DBtn.Text = "Disable 3D: " .. (State.disable3D and "ON" or "OFF")
                        
                        if GUI.setLowRenderMode then
                            pcall(GUI.setLowRenderMode, State.disable3D)
                        end
                    end)
                end)
            end)
            
        else
            
        end
        
    else
       
    end
end)
