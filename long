-- GLOBAL PLACEMENT LOCK SYSTEM (Prevent race conditions)
-- ============================================================
if not getgenv().GlobalPlacementLock then
    getgenv().GlobalPlacementLock = false
end

local function AcquirePlacementLock(systemName)
    if getgenv().GlobalPlacementLock then
        return false  -- Lock already held by another system
    end
    getgenv().GlobalPlacementLock = systemName
    return true
end

local function ReleasePlacementLock(systemName)
    if getgenv().GlobalPlacementLock == systemName then
        getgenv().GlobalPlacementLock = false
    end
end

local function SafePlacementWrapper(systemName, func)
    -- Wrapper that ensures lock is always released even on error
    if not AcquirePlacementLock(systemName) then
        return false  -- Could not acquire lock
    end
    
    local success, result = pcall(func)
    
    ReleasePlacementLock(systemName)
    
    if not success then
        warn("[PLACEMENT LOCK] Error in", systemName, ":", result)
    end
    
    return success, result
end

-- ============================================================
-- MODULE READY WAIT (Fix first-execute race condition)
-- ============================================================
local ModulesReady = false

local function WaitForModulesReady(timeout)
    print("[KAITUN DEBUG] WaitForModulesReady called - ModulesReady flag:", ModulesReady)
    
    -- Quick check: if modules already available, mark ready and return
    if CachedClientRestaurant and CachedNetwork and CachedItemDirectory then
        if not ModulesReady then
            print("[KAITUN DEBUG] Modules available but flag was false - marking ready now")
            ModulesReady = true
        end
        return true
    end
    
    if ModulesReady then
        return true  -- Already marked ready
    end
    
    print("[KAITUN DEBUG] Modules not ready - waiting up to", timeout, "seconds...")
    local deadline = tick() + (timeout or 30)
    
    while not ModulesReady and tick() < deadline do
        -- Check if core modules are loaded
        if CachedClientRestaurant and CachedNetwork and CachedItemDirectory then
            print("[KAITUN DEBUG] Modules detected as ready!")
            ModulesReady = true
            return true
        end
        task.wait(0.5)
    end
    
    if not ModulesReady then
        warn("[KAITUN DEBUG] WaitForModulesReady TIMEOUT after", timeout, "seconds!")
        warn("[KAITUN DEBUG] CachedClientRestaurant:", CachedClientRestaurant)
        warn("[KAITUN DEBUG] CachedNetwork:", CachedNetwork)
        warn("[KAITUN DEBUG] CachedItemDirectory:", CachedItemDirectory)
    end
    
    return ModulesReady
end

local function MarkModulesReady()
    print("[KAITUN DEBUG] MarkModulesReady called - setting ModulesReady = true")
    ModulesReady = true
end

