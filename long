                end

                -- Inline: Get ready crops with positions
                local readyCrops = {}
                local totalCrops = 0
                for _, Crop in ipairs(restaurant:CollectSubclass("Crop")) do
                    totalCrops = totalCrops + 1
                    if Crop:IsLocal() then
                        -- Inline: IsCropReadyByStage check
                        local ClientCrop = require(game:GetService("ReplicatedStorage").Framework.Client.ClientEntity.ClientCrop)
                        local Stage = Crop:GetSession("Stage") or 1
                        local StageCount = ClientCrop.GetStageCount(Crop) or 1
                        
