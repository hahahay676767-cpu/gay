-- AUTO PLACE RUSTY SINK (v5.0 - footprint + clearance aware)
-- Place 3 Rusty Sinks in restaurant, continuous watcher.
-- Rusty Sink butuh 2 slot per unit: 1 tile buat sink + 1 tile KOSONG
-- di depan model-nya (gak boleh ketutup apapun, termasuk sink lain).
-- Logic max target (buy+place) TETAP 3 -- cuma cara nyari & occupy
-- tile-nya yang diganti biar clearance-nya beneran dihormatin, dan
-- GetPlacedSinkCount-nya dibenerin (sebelumnya manggil DeriveSubclassName
-- yang gak pernah ke-define di script ini, jadi selalu error / gak jalan).
-- ============================================================
local RustySinkConfig = {
    ItemName = "Rusty Sink",
    TargetCount = 3,  -- Place 3 rusty sinks total
    PlaceRotation = 0,
    BuildDebounce = 0.35,
}

local AutoPlaceRustySinkEnabled = true  -- DEFAULT TRUE - langsung jalan!
local AutoPlaceRustySinkRunning = false

-- Arah "depan" sink berdasarkan rotasi placement -- tile ini WAJIB kosong.
local RustySinkFrontOffset = {
    [0]   = { 0, -1 }, -- depan = Utara
    [90]  = { 1, 0 },  -- depan = Timur
    [180] = { 0, 1 },  -- depan = Selatan
    [270] = { -1, 0 }, -- depan = Barat
}

local function GetRustySinkRequiredVoxelKeys(anchor, rotation)
    local frontOffset = RustySinkFrontOffset[rotation] or RustySinkFrontOffset[0]
    local front = { X = anchor.X + frontOffset[1], Y = anchor.Y + frontOffset[2] }

    return {
        anchor.X .. "_" .. anchor.Y,
        front.X .. "_" .. front.Y,
    }
end

-- FIX: sebelumnya manggil DeriveSubclassName(RustySinkConfig.ItemName) yang
-- gak pernah ke-define di script ini -> selalu error tiap kepanggil.
-- GetPlacedFurnitureCount emang nerima itemDisplayName langsung ("Rusty
-- Sink"), bukan subclass, jadi gak perlu derive apapun.
local function GetPlacedSinkCount(restaurant, floor)
    -- Optional args -- kalau dipanggil tanpa argumen (kayak dari Buy
    -- section di atas: GetPlacedSinkCount()), fallback resolve sendiri
    -- biar tetep kompatibel & hasilnya akurat (bukan selalu 0).
    restaurant = restaurant or CachedRestaurant or (CachedClientRestaurant and CachedClientRestaurant.GetLocal())
    if not restaurant then
        return 0
    end
    floor = floor or GetPlayerFloor(restaurant)
    return GetPlacedFurnitureCount(restaurant, RustySinkConfig.ItemName, floor)
end

-- Place sink per anchor, tapi tiap anchor "makan" 2 slot (1 sink + 1
-- clearance depan). Pola lookup-nya sama kayak PlaceFurnitureSets buat
-- Table&Chair (BuildFurnitureVoxelLookup udah ada di script ini), cuma
-- requirement tetangganya cuma 1 tile depan doang, bukan pasangan
-- berlawanan kayak Chair.
local function PlaceRustySinkSets(restaurant, voxels, maxCount, floor)
    local lookup = BuildFurnitureVoxelLookup(voxels)
    local placedCount = 0

    for _, anchor in ipairs(voxels) do
        if placedCount >= maxCount then
            break
        end

        local anchorKey = anchor.X .. "_" .. anchor.Y
        if lookup[anchorKey] then
            local requiredKeys = GetRustySinkRequiredVoxelKeys(anchor, RustySinkConfig.PlaceRotation)

            local allFree = true
            for _, key in ipairs(requiredKeys) do
                if not lookup[key] then
                    allFree = false
                    break
                end
            end

            if allFree then
                -- Pop semua tile (sink + clearance) biar gak dipake anchor
                -- lain di batch yang sama, walau clearance-nya sendiri gak
                -- diisi apapun.
                for _, key in ipairs(requiredKeys) do
                    lookup[key] = nil
                end

                task.wait(RustySinkConfig.BuildDebounce)

                if CachedNetwork then
                    CachedNetwork.Fire("Build_Place", RustySinkConfig.ItemName, anchor.X, anchor.Y, RustySinkConfig.PlaceRotation, floor)
                end

                local confirmed = WaitForPlacementConfirmed(restaurant, anchor, floor)
                if confirmed then
                    placedCount = placedCount + 1
                end
            end
        end
    end

    return placedCount
end

local function TryAutoPlaceRustySink()
    if AutoPlaceRustySinkRunning or not AutoPlaceRustySinkEnabled then
        return
    end
    
    -- Try acquire global placement lock
    if not AcquirePlacementLock("RustySink") then
        return  -- Another placement system is running
    end

    -- Check inventory dulu (murah), baru resolve restaurant/floor.
    local stock = GetItemStock(RustySinkConfig.ItemName)
    if stock <= 0 then
        ReleasePlacementLock("RustySink")
        return -- No sink to place
    end

    local Restaurant = CachedClientRestaurant
    if not Restaurant then
        Restaurant = GetClientRestaurant()
        if not Restaurant then 
            ReleasePlacementLock("RustySink")
            return 
        end
    end

    local restaurant = Restaurant.GetLocal()
    if not restaurant then 
        ReleasePlacementLock("RustySink")
        return 
    end

    local Floor = GetPlayerFloor(restaurant)

    -- Check how many sinks already placed (target = 3, sama kayak sebelumnya)
    local placedCount = GetPlacedSinkCount(restaurant, Floor)
    if placedCount >= RustySinkConfig.TargetCount then
        ReleasePlacementLock("RustySink")
        return -- Target reached
    end

    AutoPlaceRustySinkRunning = true

    task.spawn(function()
        local Voxels = GetNonDockPlaceableVoxels(restaurant, Floor)

        if #Voxels == 0 then
            AutoPlaceRustySinkRunning = false
            ReleasePlacementLock("RustySink")
            return
        end

        -- Tiap sink butuh 2 slot (sink + clearance depan), jadi maxCount
        -- dibatesin stock, sisa target, DAN separuh dari voxel kosong yang ada.
        local maxByVoxels = math.floor(#Voxels / 2)
        local maxPlace = math.min(stock, maxByVoxels, RustySinkConfig.TargetCount - placedCount)

        if maxPlace > 0 then
            PlaceRustySinkSets(restaurant, Voxels, maxPlace, Floor)
        end

        AutoPlaceRustySinkRunning = false
        ReleasePlacementLock("RustySink")  -- Release lock after placement
    end)
end

