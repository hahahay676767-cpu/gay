-- AUTO CONTINUE POPUP (Independent loop - always active)
-- Auto-click "Continue" button on RecipeDiscovery & LevelUp popups
-- Based on: auto-continue-popup.lua reference
-- ============================================================

-- Spawn independent auto-continue popup loop at file load
task.spawn(function()
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    -- Target GUI paths: { ScreenGuiName, FrameName, ButtonName }
    local TARGETS = {
        { "RecipeDiscovery", "RecipeDiscovery", "Continue" },
        { "LevelUp", "LevelUp", "Continue" },
    }
    
    local ResolvedTargets = {}
    local ClickingNow = {}
    
    local function IsFullyVisible(button, screenGui, frame)
        if not (screenGui and screenGui.Parent) then
            return false
        end
        if not screenGui.Enabled then
            return false
        end
        if not (frame and frame.Parent and frame.Visible) then
            return false
        end
        if not (button and button.Parent) then
            return false
        end
        local visOk, isVisible = pcall(function()
            return button.Visible
        end)
        if visOk and isVisible == false then
            return false
        end
        return true
    end
    
    local function TriggerButton(button, screenGui)
        local triggered = false
        
        -- Try getconnections first
        if getconnections then
            pcall(function()
                for _, conn in ipairs(getconnections(button.Activated)) do
                    if conn.Fire then
                        conn:Fire()
                        triggered = true
                    end
                end
            end)
        end
        
        -- Fallback: firesignal
        if not triggered and firesignal then
            pcall(function()
                firesignal(button.Activated)
                triggered = true
            end)
        end
        
        if not triggered and firesignal then
            pcall(function()
                firesignal(button.MouseButton1Click)
                triggered = true
            end)
        end
        
        -- Last resort: hide the GUI
        if not triggered then
            pcall(function()
                screenGui.Enabled = false
            end)
        end
        
        return triggered
    end
    
    local function TryClickTarget(index)
        if ClickingNow[index] then
            return
        end
        
        local resolved = ResolvedTargets[index]
        if not resolved then
            return
        end
        
        if not IsFullyVisible(resolved.Button, resolved.ScreenGui, resolved.Frame) then
            return
        end
        
        ClickingNow[index] = true
        
        task.spawn(function()
            TriggerButton(resolved.Button, resolved.ScreenGui)
            task.wait(0.2)
            ClickingNow[index] = false
        end)
    end
    
    -- Resolve target paths in background
    for index, target in ipairs(TARGETS) do
        local screenGuiName, frameName, buttonName = target[1], target[2], target[3]
        
        task.spawn(function()
            pcall(function()
                local screenGui = PlayerGui:WaitForChild(screenGuiName, 15)
                if not screenGui then return end
                
                local frame = screenGui:WaitForChild(frameName, 15)
                if not frame then return end
                
                local button = frame:WaitForChild(buttonName, 15)
                if not button then return end
                
                ResolvedTargets[index] = {
                    Button = button,
                    ScreenGui = screenGui,
                    Frame = frame,
                }
                
                -- Event-driven: auto-click when GUI opens
                screenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                    TryClickTarget(index)
                end)
                frame:GetPropertyChangedSignal("Visible"):Connect(function()
                    TryClickTarget(index)
                end)
            end)
        end)
    end
    
    -- Watcher loop: backup polling every 0.25s
    while true do
        task.wait(0.25)
        
        for index in pairs(ResolvedTargets) do
            TryClickTarget(index)
        end
    end
end)

