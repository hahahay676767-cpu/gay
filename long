-- Get current main quest number (e.g., 1, 28, etc.)
-- Returns the highest completed main quest number + 1 (next quest to complete)
local function GetMainQuestNumber()
    local Saving = GetSaving()
    if not Saving then return 0 end
    
    local saveData = Saving.Get()
    if not saveData or not saveData.Goals then return 0 end
    
    local highestQuestNum = 0
    
    -- Iterate through all goals to find main quests (Tag2 = "Quest_X")
    for goalId, goalData in pairs(saveData.Goals) do
        if goalData.Tag2 and type(goalData.Tag2) == "string" then
            local questNum = tonumber(string.match(goalData.Tag2, "Quest_(%d+)"))
            if questNum then
                -- If quest is completed, track the highest completed quest number
                if goalData.Completed and questNum > highestQuestNum then
                    highestQuestNum = questNum
                end
            end
        end
    end
    
    -- Return next quest number (highest completed + 1)
    -- If no quests completed yet, returns 1 (starting quest)
    return highestQuestNum > 0 and highestQuestNum or 0
end

