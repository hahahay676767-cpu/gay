local function resetAfkState()
	pcall(function()
		VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
		task.wait(0.1)
		VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
	end)
end

-- ← DIOPTIMASI: Gabung 2 loop Heartbeat jadi 1 polling loop
local function startAntiAfkLoop()
	if antiAfkConnection then
		return
	end
	
	antiAfkConnection = true
	task.spawn(function()
		local lastResetTime = 0
		
		while antiAfkEnabled do
			task.wait(1)  -- Cek tiap 1 detik, jauh lebih hemat dari Heartbeat
			
			if not antiAfkEnabled then
				break
			end
			
			local now = tick()
			
			-- Cek click interval
			if now - lastClickTime >= clickInterval then
				lastClickTime = now
				realScreenClick()
			end
			
			-- Cek reset interval (10 menit)
			if now - lastResetTime >= 600 then
				lastResetTime = now
				resetAfkState()
			end
		end
		
		antiAfkConnection = nil
	end)
end

local function stopAntiAfkLoop()
	antiAfkEnabled = true
	antiAfkConnection = nil
end

